# Optional: pin a private Ethereum Sepolia RPC (Alchemy/Infura/etc.).
# Falls back to public endpoints when unset.
VITE_RPC_URL=

# Uniswap Trading API key (developers.uniswap.org). No VITE_ prefix on purpose:
# the key is injected server-side by the /api/uniswap proxy (vite.config.js)
# and never reaches the browser bundle.
UNISWAP_API_KEY=
